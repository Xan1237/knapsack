OPENAI_API_KEY=
# Astra handles photo recognition, triangle-mesh generation, and packing advice.
OPENAI_MODEL=gpt-6-astra

# Supabase project URL. The API only serves users signed in to this project.
SUPABASE_URL=https://your-project.supabase.co
# Secret key (Project Settings > API Keys > Secret keys). Server only: it bypasses row-level
# security, so never put it in the app or commit it.
SUPABASE_SECRET_KEY=
