# Copy to .env.local (ignored by git) and fill in from Supabase: Project Settings > API Keys.
# The publishable key is meant for apps; never put a secret or service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional: where the Python backend runs, if not this computer on port 8000.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
